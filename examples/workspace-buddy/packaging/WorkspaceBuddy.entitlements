<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Unlike plate-today(-tools), sandboxing here is NOT a build-time opt-in — it's what makes
	     the whole point of this example (docs/sdk-guide.md §8's security-scoped bookmark pattern)
	     actually necessary to demonstrate. Outside a sandbox, a plainly-remembered folder path
	     would just keep working across relaunches and the bookmark dance would prove nothing. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Grants read/write access to whatever folder the user picks via NSOpenPanel — the actual
	     entitlement that makes WorkspaceAccess's write/edit/delete calls work at all under
	     sandbox, not just read. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
