<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Requires a matching NS*FullAccessUsageDescription key in Info.plist AND must be present
	     on every codesign call that touches this binary, including the final sign of the outer
	     .app bundle. Confirmed live, the exact multi-step TCC failure mode this avoids: missing
	     entitlement gives "Policy disallows prompt"; missing Info.plist key gives "Refusing
	     authorization request without NSCalendarsUsageDescription key"; a final bundle-level
	     codesign that omits the entitlements flag silently strips what an earlier per-binary sign
	     applied. build-and-sign.sh's final codesign call passes the entitlements flag for exactly
	     this reason.
	     There is no separate "reminders" sandbox entitlement — Reminders access (EventKit) is
	     covered by this same calendars entitlement; only the Info.plist
	     NSRemindersFullAccessUsageDescription key and the TCC prompt itself are Reminders-specific.
	     A com.apple.security.personal-information.reminders key was present here previously; it
	     isn't a real Apple entitlement and App Store Connect's real validation (not local
	     codesign/pkgutil checks) rejects it outright — found via a real Transporter upload
	     attempt, 2026-08-14. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<!-- com.apple.security.personal-information.location is intentionally NOT here by default —
	     Location/Weather is a build-time opt-in (see ../Package.swift), off by default.
	     build-and-sign.sh adds this key via PlistBuddy only when
	     PLATETODAY_INCLUDE_LOCATION_WEATHER=1. -->
</dict>
</plist>
