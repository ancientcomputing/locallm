	<!-- Redirect target for an MCP server's OAuth flow (see Core's MCPOAuthFlow.swift and
	     ComponentsDemoApp.swift's init(), which sets MCPOAuthFlow.redirectURI to match this
	     scheme). Distinct from both plate-today's "platetoday" scheme and LocalLM Lab's own
	     "locallmlab" scheme so none collide if all three are installed on the same Mac. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key><string>lab.locallm.sdk.reference.componentsdemo.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>componentsdemo</string>
			</array>
		</dict>
	</array>
</dict>
